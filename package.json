{
  "name": "interlis-vscode",
  "displayName": "INTERLIS",
  "description": "INTERLIS 2.3/2.4 editing with the Java INTERLIS language server",
  "version": "0.0.1",
  "publisher": "edigonzales",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edigonzales/interlis-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onLanguage:interlis"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax resources work; the Java language server requires workspace trust."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "interlis",
        "aliases": [
          "INTERLIS"
        ],
        "extensions": [
          ".ili",
          ".ILI"
        ],
        "configuration": "./resources/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "interlis",
        "scopeName": "source.interlis",
        "path": "./resources/syntaxes/interlis.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "interlis",
        "path": "./resources/snippets/interlis.json"
      }
    ],
    "commands": [
      {
        "command": "interlisGuru.restartServer",
        "title": "INTERLIS: Restart Language Server"
      },
      {
        "command": "interlisGuru.stopServer",
        "title": "INTERLIS: Stop Language Server"
      },
      {
        "command": "interlisGuru.showOutput",
        "title": "INTERLIS: Show Language Server Output"
      },
      {
        "command": "interlisGuru.newFromTemplate",
        "title": "INTERLIS: New Model from Template"
      },
      {
        "command": "interlisGuru.compileCurrent",
        "title": "INTERLIS: Compile Current Model"
      },
      {
        "command": "interlisGuru.compileWorkspace",
        "title": "INTERLIS: Compile Workspace"
      },
      {
        "command": "interlisGuru.showDiagram",
        "title": "INTERLIS: Show Diagram for This File"
      },
      {
        "command": "interlisGuru.diagram.reveal",
        "title": "INTERLIS: Reveal Source Selection in Diagram"
      },
      {
        "command": "interlisGuru.diagram.refresh",
        "title": "INTERLIS: Refresh Diagram"
      },
      {
        "command": "interlisGuru.diagram.settle",
        "title": "INTERLIS: Settle Diagram Layout"
      },
      {
        "command": "interlisGuru.diagram.resetLayout",
        "title": "INTERLIS: Reset Diagram Layout"
      },
      {
        "command": "interlisGuru.diagram.export",
        "title": "INTERLIS: Export Current Diagram"
      },
      {
        "command": "interlisGuru.documentation.preview",
        "title": "INTERLIS: Preview Documentation"
      },
      {
        "command": "interlisGuru.documentation.export",
        "title": "INTERLIS: Export Documentation"
      },
      {
        "command": "interlisGuru.documentation.configure",
        "title": "INTERLIS: Documentation Options"
      },
      {
        "command": "interlisGuru.exportGraph",
        "title": "INTERLIS: Export Graph"
      }
    ],
    "configuration": {
      "title": "INTERLIS",
      "properties": {
        "interlisGuru.server.javaPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit Java 25 executable. Required by the initial development distribution."
        },
        "interlisGuru.server.bundlePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Explicit development server distribution. Empty uses the packaged server; every file must match the artifact lock."
        },
        "interlisGuru.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "machine",
          "description": "Language Server Protocol trace. Verbose includes source contents; enable deliberately for diagnostics."
        },
        "interlisGuru.diagnostics.language": {
          "type": "string",
          "enum": [
            "auto",
            "de",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "description": "Diagnostic language; auto follows the VS Code UI with English fallback."
        },
        "interlisGuru.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://models.interlis.ch/"
          ],
          "scope": "window",
          "description": "Ordered model repositories. Local workspace models take precedence. Downloads require a trusted workspace."
        },
        "interlisGuru.offline": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Resolve external models only from the verified repository cache. No HTTP requests."
        },
        "interlisGuru.modelPins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "modelName",
              "modelVersion",
              "sourceId",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "modelName": {
                "type": "string"
              },
              "modelVersion": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "default": [],
          "scope": "window",
          "description": "Exact external model identities and original byte digests."
        },
        "interlisGuru.sourcePins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceId",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "default": [],
          "scope": "window",
          "description": "Exact external source/index byte digests."
        },
        "interlisGuru.resolutionLock": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Optional versioned resolution-lock XML from the Java compiler; an empty string disables replay."
        },
        "interlisGuru.diagram.autoOpenBeside": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Automatically open beside an INTERLIS source while preserving editor focus."
        },
        "interlisGuru.diagram.followEditor": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Initial explicit follow-active-source mode."
        },
        "interlisGuru.diagram.showAssociationNames": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Initial local diagram presentation setting."
        },
        "interlisGuru.diagram.showRoleCardinalities": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Initial local diagram presentation setting."
        },
        "interlisGuru.diagram.showLocalEnumerationValues": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Initial local diagram presentation setting."
        },
        "interlisGuru.diagram.attributeMode": {
          "type": "string",
          "enum": [
            "OWN",
            "OWN_AND_INHERITED",
            "NONE"
          ],
          "default": "OWN",
          "scope": "window",
          "description": "Initial local diagram presentation setting; each panel has independent controls."
        },
        "interlisGuru.diagram.edgeRouting": {
          "type": "string",
          "enum": [
            "ORTHOGONAL",
            "POLYLINE",
            "SPLINES"
          ],
          "default": "ORTHOGONAL",
          "scope": "window",
          "description": "Initial local diagram presentation setting; each panel has independent controls."
        },
        "interlisGuru.diagram.nodePlacement": {
          "type": "string",
          "enum": [
            "BRANDES_KOEPF",
            "SIMPLE",
            "INTERACTIVE",
            "LINEAR_SEGMENTS",
            "NETWORK_SIMPLEX"
          ],
          "default": "BRANDES_KOEPF",
          "scope": "window",
          "description": "Initial local diagram presentation setting; each panel has independent controls."
        },
        "interlisGuru.diagram.rendering.target": {
          "type": "string",
          "enum": [
            "STANDARD",
            "INKSCAPE"
          ],
          "default": "STANDARD",
          "scope": "window",
          "description": "Initial local diagram presentation setting; each panel has independent controls."
        },
        "interlisGuru.diagram.edgeCrossings": {
          "type": "string",
          "enum": [
            "GAPS",
            "PLAIN"
          ],
          "default": "GAPS",
          "scope": "window",
          "description": "Initial local diagram presentation setting; each panel has independent controls."
        },
        "interlisGuru.documentation.language": {
          "type": "string",
          "enum": [
            "auto",
            "DE",
            "FR",
            "IT",
            "EN"
          ],
          "default": "auto",
          "scope": "window",
          "description": "Language of catalogue labels; identifiers and model comments stay unchanged."
        },
        "interlisGuru.documentation.inheritance": {
          "type": "string",
          "enum": [
            "SEPARATE",
            "INLINE",
            "INLINE_ABSTRACT_ONLY"
          ],
          "default": "SEPARATE",
          "scope": "window",
          "description": "How inherited members are presented."
        },
        "interlisGuru.documentation.headers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          },
          "scope": "window",
          "description": "Catalogue header labels (catalog, name, kind, type, cardinality, origin, description, constraints, inherited, base)."
        },
        "interlisGuru.templates.url": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Explicitly selected HTTPS template URL. HTTP is allowed only for a loopback test server."
        },
        "interlisGuru.templates.file": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Explicit absolute path to an optional local template."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "interlisGuru.diagram",
        "displayName": "INTERLIS UML",
        "selector": [
          {
            "filenamePattern": "*.ili"
          },
          {
            "filenamePattern": "*.ILI"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "key": "enter",
        "command": "acceptSelectedSuggestion",
        "when": "editorTextFocus && editorLangId == interlis && suggestWidgetVisible && suggestionMakesTextEdit"
      },
      {
        "key": "enter",
        "command": "interlisGuru.snippet.next",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "left",
        "command": "interlisGuru.snippet.cursorLeft",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "right",
        "command": "interlisGuru.snippet.cursorRight",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "up",
        "command": "interlisGuru.snippet.cursorUp",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "down",
        "command": "interlisGuru.snippet.cursorDown",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "home",
        "command": "interlisGuru.snippet.cursorHome",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "end",
        "command": "interlisGuru.snippet.cursorEnd",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "pageup",
        "command": "interlisGuru.snippet.cursorPageUp",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "pagedown",
        "command": "interlisGuru.snippet.cursorPageDown",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "tab",
        "command": "interlisGuru.snippet.next",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && hasNextTabstop && !suggestWidgetVisible"
      },
      {
        "key": "escape",
        "command": "interlisGuru.snippet.leave",
        "when": "editorTextFocus && editorLangId == interlis && inSnippetMode && !suggestWidgetVisible"
      },
      {
        "key": "enter",
        "command": "interlisGuru.editor.newline",
        "when": "editorTextFocus && editorLangId == interlis && !editorReadonly && !suggestWidgetVisible && !hasNextTabstop"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "stage:core": "node scripts/stage-core.cjs",
    "test:unit": "node --test test/unit/*.test.cjs",
    "test:protocol": "node --test test/protocol.test.cjs",
    "test:gui": "node scripts/gui.cjs",
    "package:vsix": "node scripts/package.cjs",
    "verify:no-legacy-dependencies": "node scripts/verify-dependencies.cjs",
    "test:extension-host": "node scripts/extension-host.cjs",
    "test:installed": "node scripts/gui.cjs --suite smoke",
    "review": "node scripts/review.cjs"
  },
  "dependencies": {
    "sax": "1.6.1",
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.0",
    "clipboardy": "5.3.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vscode-extension-tester": "8.28.1"
  },
  "overrides": {
    "vscode-languageclient": {
      "minimatch": "11.0.1"
    }
  }
}
