!! Grüezi 😀 native view controls
INTERLIS 2.4;
MODEL Comfort AT "x" VERSION "1" =
IMPORTS V3Middle;
DOMAIN Number=0..999; State=(first,second);
TOPIC Data(ABSTRACT)=OID AS INTERLIS.UUIDOID;
STRUCTURE Info=value:TEXT*12;END Info;
CLASS A(ABSTRACT)=number:Number;external:V3Middle.Link;flag:(first,group(child));part:Info;MANDATORY CONSTRAINT number>=0;END A;
CLASS B EXTENDS A=local:TEXT*20;END B;
CLASS C=END C;
VIEW Overview PROJECTION OF a~A; = ALL OF a; END Overview;
ASSOCIATION Many=one--{1}A;two--{0..*}B;three--{1}C;note:TEXT*20;END Many;
ASSOCIATION Self=parent--{0..1}A;children--{*}A;END Self;
END Data;END Comfort.
