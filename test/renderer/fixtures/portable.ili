INTERLIS 2.3;MODEL F AT "x" VERSION "1"=DOMAIN State=(first,group(child));TOPIC T (ABSTRACT)=CLASS A (ABSTRACT)=n:0..999;END A;CLASS B EXTENDS A=END B;CLASS C=END C;ASSOCIATION Link=one--{1} A;two--{0..*} B;three--{1} C;note:TEXT;END Link;ASSOCIATION Self=parent--{0..1}A;children--{*}A;END Self;ASSOCIATION Owns=owner-<#>{1}A;items--{*}B;END Owns;ASSOCIATION Parallel=fromA--{1}A;toB--{*}B;END Parallel;END T;END F.