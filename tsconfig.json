{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build/types",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "elkjs/lib/elk-api.js": [
        "./src/diagram/renderer/contracts/elk.d.ts"
      ],
      "elkjs/lib/elk.bundled.js": [
        "./src/diagram/renderer/contracts/elk.d.ts"
      ],
      "libavoid-js": [
        "./src/diagram/renderer/contracts/libavoid-js.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
