{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "INTERLIS Editor: Build LSP + Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}/build/dev-extension",
        "${workspaceFolder}/test/fixtures/editor-basic"
      ],
      "outFiles": [
        "${workspaceFolder}/build/dev-extension/out/**/*.cjs"
      ],
      "preLaunchTask": "INTERLIS: Prepare Development Host",
      "envFile": "${workspaceFolder}/build/dev.env"
    }
  ]
}
