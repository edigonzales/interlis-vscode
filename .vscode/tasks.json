{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "INTERLIS: Prepare Development Host",
      "type": "shell",
      "command": "npm run dev:prepare",
      "osx": {
        "command": "/bin/sh",
        "args": [{ "value": "${workspaceFolder}/scripts/prepare-dev-macos.sh", "quoting": "strong" }]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
