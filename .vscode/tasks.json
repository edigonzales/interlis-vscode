{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "INTERLIS: Prepare Development Host",
      "type": "shell",
      "command": "npm run dev:prepare",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
